{
  "name": "cc-park",
  "version": "0.1.0",
  "description": "マシン上で稼働中の Claude Code セッションをキャラクターで一覧表示するターミナル TUI / デスクトップ GUI",
  "type": "module",
  "bin": {
    "cc-park": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && npm run build:gui",
    "build:gui": "npm run build:preload && vite build",
    "build:preload": "vite build --config vite.preload.config.ts",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "gui": "ELECTRON_RUN_AS_NODE= electron dist/gui/main.js",
    "gui:dev": "npm run build && npm run gui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.gui.json"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "tui",
    "ink",
    "gui",
    "electron",
    "desktop"
  ],
  "license": "MIT",
  "dependencies": {
    "electron": "^44.4.3",
    "ink": "^7.1.1",
    "meow": "^14.1.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^29.1.1",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
